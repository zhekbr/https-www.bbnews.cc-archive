{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pt/tag/:slug*",
      "destination": "/pt/index.html"
    },
    {
      "source": "/en/tag/:slug*",
      "destination": "/en/index.html"
    },
    {
      "source": "/pt/regiao/:slug*",
      "destination": "/pt/index.html"
    },
    {
      "source": "/en/region/:slug*",
      "destination": "/en/index.html"
    },
    {
      "source": "/pt/news/:slug*",
      "destination": "/pt/index.html"
    },
    {
      "source": "/en/news/:slug*",
      "destination": "/en/index.html"
    },
    {
      "source": "/pt/archive",
      "destination": "/pt/archive/index.html"
    },
    {
      "source": "/en/archive",
      "destination": "/en/archive/index.html"
    },
    {
      "source": "/pt/privacy",
      "destination": "/pt/privacy/index.html"
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy/index.html"
    },
    {
      "source": "/pt/:path*",
      "destination": "/pt/index.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/en/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https://*.supabase.co https://api.binance.com https://www.google-analytics.com https://region1.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(xml|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600"
        }
      ]
    }
  ]
}
